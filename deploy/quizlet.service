[Unit]
Description=Quizlet 2.0 web server
After=network-online.target
Wants=network-online.target

[Service]
# Change the paths if you put the folder somewhere else.
# Runs as the unprivileged "quizlet" user; create it first (see HOW-TO-RUN.md).
WorkingDirectory=/opt/quizlet
ExecStart=/usr/bin/node /opt/quizlet/server.mjs
User=quizlet
Group=quizlet

Environment=PORT=8787
# Reachable only through Tailscale by default. Set HOST=0.0.0.0 to also allow
# devices on the same home network to connect directly.
Environment=HOST=127.0.0.1

# Optional AI grading of typed answers. Put GROQ_API_KEY=... (and optionally
# GROQ_MODEL=...) in this file. The leading "-" means the service still starts
# normally if the file is absent, so AI grading is simply off until you add it.
EnvironmentFile=-/etc/quizlet.env

Restart=always
RestartSec=2

# A little hardening; harmless if you don't understand it.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/quizlet/data

[Install]
WantedBy=multi-user.target
